set shell := ["zsh", "-cu"]

default:
    @just --list

# one-time: install deps + register this venv as a Jupyter kernel
setup:
    uv sync
    uv run python -m ipykernel install --user --name lancedb-lab --display-name "lancedb-lab"

# run a lesson as a notebook, print cell outputs: just run 1
run n:
    rm -rf data/lesson{{n}}
    uv run jupytext --set-kernel python3 --to ipynb --execute lesson{{n}}_*.py >/dev/null 2>&1
    uv run jupyter nbconvert --to markdown --stdout --NbConvertBase.display_data_priority='["text/plain"]' lesson{{n}}_*.ipynb 2>/dev/null | rg -v '^\s*$|WARN'

# build notebooks from the .py sources (py is source of truth)
nb:
    uv run jupytext --set-kernel python3 --to ipynb lesson*.py

# open JupyterLab on the notebooks
lab: nb
    uv run jupyter lab --notebook-dir=. --port 8888

# show what a lesson left on disk
tree:
    tree data

# wipe generated Lance tables and notebooks
clean:
    rm -rf data *.ipynb .ipynb_checkpoints
